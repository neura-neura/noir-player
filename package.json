{
  "name": "noir-player",
  "version": "0.1.15",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "description": "Windows desktop video player built with Tauri, React, native libmpv playback, and FFmpeg-assisted fallback.",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420",
    "build": "vite build && node scripts/check-bundle-size.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/runtime.test.ts tests/events-hooks-commands.test.ts tests/snapshot-and-engines.test.ts",
    "test:integration": "vitest run tests/surface-coordinator.test.ts tests/subtitles-characterization.test.ts",
    "test:components": "vitest run tests/ui-slots.test.tsx tests/playback-stats.test.ts",
    "test:contracts": "vitest run tests/sdk-contract.test.ts tests/architecture.test.ts tests/scaffold.test.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:boundaries": "node scripts/check-plugin-boundaries.mjs",
    "check:rust": "cargo fmt --check --manifest-path src-tauri/Cargo.toml && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path src-tauri/Cargo.toml",
    "check": "npm run typecheck && npm run check:boundaries && npm run lint && npm run test && npm run build",
    "create-plugin": "node scripts/create-plugin.mjs",
    "stage:ffmpeg": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-ffmpeg.ps1",
    "stage:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-native-runtime.ps1",
    "verify:native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stage-native-runtime.ps1 -VerifyOnly",
    "tauri:smoke": "tauri dev --no-watch"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "@tauri-apps/plugin-process": "2.3.1",
    "@tauri-apps/plugin-updater": "2.10.1",
    "@tauri-apps/plugin-window-state": "2.4.1",
    "dompurify": "3.4.13",
    "hls.js": "^1.6.16",
    "jschardet": "3.1.4",
    "jszip": "3.10.1",
    "lucide-react": "^1.28.0",
    "plyr": "3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "semver": "7.8.5",
    "tauri-plugin-libmpv-api": "^0.3.2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.0",
    "@playwright/test": "1.62.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/semver": "7.7.1",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "9.39.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "jsdom": "29.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
