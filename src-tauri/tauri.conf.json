{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noir Player",
  "version": "0.1.16",
  "identifier": "com.neura.noirwebplayer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Noir Player",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "transparent": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
    "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost http://127.0.0.1:* ws://127.0.0.1:1420 https://cdn.jsdelivr.net https://api.github.com https://raw.githubusercontent.com; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob: data: http://127.0.0.1:*; style-src 'self' 'unsafe-inline' asset: http://asset.localhost https://cdn.jsdelivr.net; font-src 'self' asset: http://asset.localhost data: https://cdn.jsdelivr.net; script-src 'self' blob: 'wasm-unsafe-eval'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": [
      "resources/bin",
      "lib/**/*"
    ],
    "fileAssociations": [
      {
        "name": "video",
        "description": "Video files",
        "role": "Editor",
        "ext": [
          "mp4",
          "mkv",
          "avi",
          "mov",
          "m4v",
          "webm",
          "ts",
          "m2ts",
          "wmv",
          "flv"
        ]
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEMTEwNTlBNUQ3NkM3ClJXVEhkbDJhQlJIdEFDRG9zRitSUTBUOVd3VTlUMkZzYWZmRnpQUm85dUpkUVUybFVTOE1WWmx6Cg==",
      "endpoints": [
        "https://github.com/neura-neura/noir-player/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
