{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noir Player",
  "version": "0.1.0",
  "identifier": "com.neura.noirwebplayer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Noir Player",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      },
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "resources/bin/ffmpeg.exe",
      "resources/bin/ffprobe.exe"
    ],
    "fileAssociations": [
      {
        "name": "video",
        "description": "Video files",
        "role": "Editor",
        "ext": [
          "mp4",
          "mkv",
          "avi",
          "mov",
          "m4v",
          "webm",
          "ts",
          "m2ts",
          "wmv",
          "flv"
        ]
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
